# Porta do servidor
PORT=3000

# Segredo opcional usado para validar assinatura do webhook (se configurado na Infinity Pay)
INFINITY_PAY_WEBHOOK_SECRET=

# Método de envio de e-mail (opcional):
# - Se estiver usando SendGrid, forneça SENDGRID_API_KEY e FROM_EMAIL
# - Se preferir SMTP (ex: Gmail, Outlook), configure SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS e FROM_EMAIL

# SendGrid
SENDGRID_API_KEY=

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# E-mail remetente (ex: "Dr. José Sousa <suporte@seudominio.com>")
FROM_EMAIL=

# E-mail do dono (recebe notificação de venda)
OWNER_EMAIL=
